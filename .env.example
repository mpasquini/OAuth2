# OAuth2 Project - Environment Configuration Template
# Copy this to .env and fill in actual values for your environment

# ==================== ENVIRONMENT ====================
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ==================== AUTHORIZATION SERVER ====================
AUTH_SERVER_HOST=0.0.0.0
AUTH_SERVER_PORT=5000
AUTH_SERVER_URL=http://localhost:5000
AUTH_SERVER_SECRET_KEY=your-super-secret-key-change-in-production
AUTH_SERVER_ALGORITHM=HS256

# Token Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTHORIZATION_CODE_EXPIRE_MINUTES=10

# ==================== RESOURCE SERVER ====================
RESOURCE_SERVER_HOST=0.0.0.0
RESOURCE_SERVER_PORT=5002
RESOURCE_SERVER_URL=http://localhost:5002

# Token Validation (validate against auth server)
TOKEN_VALIDATION_MODE=jwt  # Options: jwt, introspection
AUTH_SERVER_INTROSPECTION_URL=http://auth-server:5000/introspect

# ==================== CLIENT APPLICATION ====================
CLIENT_APP_HOST=0.0.0.0
CLIENT_APP_PORT=5001
CLIENT_APP_URL=http://localhost:5001
CLIENT_APP_SECRET_KEY=your-flask-secret-key-change-in-production

# OAuth2 Client Credentials (registered with Authorization Server)
OAUTH2_CLIENT_ID=web-client
OAUTH2_CLIENT_SECRET=web-client-secret
OAUTH2_REDIRECT_URI=http://localhost:5001/callback

# Authorization Server URL
OAUTH2_AUTHORIZE_URL=http://localhost:5000/authorize
OAUTH2_TOKEN_URL=http://localhost:5000/token
OAUTH2_USERINFO_URL=http://localhost:5000/userinfo

# ==================== DATABASE ====================
# PostgreSQL Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=oauth2
DB_USER=oauth2_user
DB_PASSWORD=oauth2_password

# SQLite (for local development, alternative to PostgreSQL)
# SQLALCHEMY_DATABASE_URL=sqlite:///./oauth2.db

# ==================== SECURITY ====================
# CORS Configuration
CORS_ORIGINS=http://localhost:5001,http://localhost:5000,http://localhost:5002

# SSL/TLS (production)
USE_SSL=false
SSL_CERT_PATH=/etc/ssl/certs/server.crt
SSL_KEY_PATH=/etc/ssl/private/server.key

# ==================== TESTING ====================
TEST_DB_URL=sqlite:///./test.db
TEST_AUTH_SERVER_URL=http://localhost:5000
TEST_RESOURCE_SERVER_URL=http://localhost:5002
TEST_CLIENT_APP_URL=http://localhost:5001

# ==================== EXTERNAL SERVICES ====================
# Email (for password reset, user verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ==================== CLOUD DEPLOYMENT ====================
# AWS (if deploying to AWS)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-key
AWS_SECRET_ACCESS_KEY=your-secret
RDS_ENDPOINT=your-rds-endpoint.amazonaws.com

# Google Cloud Platform
GCP_PROJECT_ID=your-project-id
GCP_CREDENTIALS_JSON=/path/to/credentials.json

# ==================== MONITORING ====================
# Sentry (error tracking)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Application Performance Monitoring
APM_ENABLED=false
APM_SERVICE_NAME=oauth2-project
